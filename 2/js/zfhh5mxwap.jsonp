1\",\"bitRate\":\"2840632\",\"Codec ID\":\"avc1\",\"codec\":\"h264\",\"colorPrimaries\":\"bt709\",\"colorSpace\":\"bt709\",\"colorTransfer\":\"bt709\",\"duration\":85.566667,\"height\":1920,\"pixelFormat\":\"yuv420p\",\"rFrameRate\":\"30/1\",\"width\":1080}}","built_by":"render-pipeline","time_to_ready":21.543150729},"url":"https://embed-ssl.wistia.com/deliveries/053b6fa09c2a816228a7bd166e939226f1a2e5e7.bin","created_at":1786341671,"segment_duration":3,"opt_vbitrate":5625},{"is_enhanced":false,"type":"still_image","slug":"still_image_1080x1920","display_name":"Thumbnail Image","details":{},"width":1080,"height":1920,"ext":"jpg","size":1357343,"bitrate":0,"public":true,"status":2,"progress":1.0,"metadata":{"time_to_ready":7.362475827},"url":"https://embed-ssl.wistia.com/deliveries/9f269ae312d4e0d18ddec000c426f9ed4025acb8.bin","created_at":1786341671},{"is_enhanced":false,"type":"storyboard","slug":"storyboard_3550x3600","display_name":"Storyboard","details":{},"width":3550,"height":3600,"ext":"jpg","size":2142160,"bitrate":0,"public":true,"status":2,"progress":1.0,"metadata":{"built_by":"render-pipeline","frame_count":171,"aspect_ratio":0.5625,"frame_height":200,"frame_width":355,"time_to_ready":7.725083985},"url":"https://embed-ssl.wistia.com/deliveries/d0038f13fff21c3a3452eea2a0370ddd24a19f65.bin","created_at":1786341671}],"branding":false,"createdAt":1786341671,"distilleryUrl":"https://distillery.wistia.com/x","duration":85.5888,"enableCustomerLogo":true,"firstEmbedForAccount":false,"firstShareForAccount":false,"availableTranscripts":[{"bcp47LanguageTag":"pt","familyName":"Portuguese","familyNativeName":"Português","hasCaptions":true,"hasVideoStream":false,"name":"Portuguese","nativeName":"Português","wistiaLanguageCode":"por","language":"por","ietf_language_tag":"por","alpha3_terminologic":"por","alpha3_bibliographic":"por","iso639_2_language_code":"pt","english_name":"Portuguese","native_name":"Português","right_to_left":false,"alpha3Bibliographic":"por","alpha3Terminologic":"por","ietfLanguageTag":"por","iso6392LanguageCode":"pt","genericName":"Portuguese","genericNativeName":"Português"}],"hashedId":"zfhh5mxwap","mediaId":151335317,"mediaKey":"wistia-production_151335317","mediaType":"Video","name":"Reportagem Shein","preloadPreference":null,"progress":1.0,"protected":false,"projectId":10872882,"seoDescription":"a Shein video","showAbout":true,"status":2,"type":"Video","playableWithoutInstantHls":true,"stats":{"loadCount":44130,"playCount":38498,"uniqueLoadCount":35587,"uniquePlayCount":34473,"averageEngagement":0.569442},"trackingTransmitInterval":20,"liveStreamEventDetails":null,"integrations":{},"tagManager":true,"captions":[{"language":"por","text":"Atenção, hoje é o último dia para participar da promoção de aniversário da Chem, milhares de brasileiras já receberam sacolas de roupas e acessórios em casa sem pagar nada. Nós fomos até algumas ganhadoras para confirmar. Olha só o que elas estão falando. A gente está aqui com a Shella, me conta como você fez para ganhar todas essas sáculas da Shen?\n\nAh, eu confesso que não acreditei quando vi aparecer vídeo falando que eu fui selecionada para promoção de aniversário da Shil, eu respondi umas perguntinha lá e quatro dias depois chegou isso tudo aqui na minha porta, eu quase chorei quando vi.\n\nMais uma participante aqui recebeu, me fala, que que você achou de tudo isso?\n\nAmiga, quando eu te falo que eu não perdi tempo, eu não perdi tempo. O vídeo apareceu para mim de noite, eu já participei na hora, respondi as cinco perguntas, cadastrei meu endereço e pensei, se vier eu, três dias depois bateu na minha porta com isso aqui tudo. Eu pulei tanto de alegria que meu cachorro ficou louco achando que era largo.\n\nIsso tudo é promoção? Me conta como foi.\n\nTudo, tudo é promoção, olha isso aqui, olha a qualidade. Eu sempre compro na Sheig, gasto meu dinheirinho lá todo mês, mas nunca tinha ganhado nada assim. Foi super simples e responder lá as perguntas nem demorou cinco minutos, e recebi isso tudo de graça, não paguei nada, só o frete.\n\nMais uma ganhadora aqui, quando você ficou sabendo que tinha ganhado, o que você pensou?\n\nPensou que era mentira não é? Eu vi lá o vídeo falando da promoção de aniversário e pensei ah vou tentar não não custa nada. Respondi as perguntinhas e quando chegou essa caixa eu gritei tanto vizinho veio perguntar se está tudo bem. Olha isso tem roupa aqui por uns três meses.\n\nComo vocês viram as ganhadoras estão recebendo de verdade. A promoção de aniversário da Shein encerra hoje à meia-noite. Se você ainda não participou, esse é o momento, é rapidinho, são só cinco perguntas. Não perca essa chance."}],"hls_enabled":true,"embed_options":{"opaqueControls":null,"playerColor":"#ff5117","playerColorGradient":{"on":false,"colors":[["#ff5117",0],["#ffb77d",1]],"on":false,"colors":[["#ff5117",0],["#ffb77d",1]]},"plugin":{},"volumeControl":"false","fullscreenButton":"false","controlsVisibleOnLoad":"false","bpbTime":"false","roundedPlayer":12,"vulcan":true,"autoPlay":"true","playButton":"false","smallPlayButton":"false","playbar":"false","settingsControl":"false","contrastIcons":null,"newRoundedIcons":true,"shouldShowCaptionsSettings":true},"embedOptions":{"opaqueControls":null,"playerColor":"#ff5117","playerColorGradient":{"on":false,"colors":[["#ff5117",0],["#ffb77d",1]],"on":false,"colors":[["#ff5117",0],["#ffb77d",1]]},"plugin":{},"volumeControl":"false","fullscreenButton":"false","controlsVisibleOnLoad":"false","bpbTime":"false","roundedPlayer":12,"vulcan":true,"autoPlay":"true","playButton":"false","smallPlayButton":"false","playbar":"false","settingsControl":"false","contrastIcons":null,"newRoundedIcons":true,"shouldShowCaptionsSettings":true}},"options":{}};
