nguageTag":"por","iso6392LanguageCode":"pt","genericName":"Portuguese","genericNativeName":"Português"}],"hashedId":"mn4cyvnrgm","mediaId":151581340,"mediaKey":"wistia-production_151581340","mediaType":"Video","name":"Vídeo entrega Shein","preloadPreference":null,"progress":1.0,"protected":false,"projectId":10872882,"seoDescription":"a Shein video","showAbout":true,"status":2,"type":"Video","playableWithoutInstantHls":true,"stats":{"loadCount":11906,"playCount":11343,"uniqueLoadCount":9056,"uniquePlayCount":9216,"averageEngagement":0.81117},"trackingTransmitInterval":20,"liveStreamEventDetails":null,"integrations":{},"tagManager":true,"captions":[{"language":"por","text":"Oie, primeiro quero te parabenizar por ter sido uma das escolhidas para participar desse questionário premiado de aniversário da Shem. Antes de continuarmos eu preciso te explicar uma coisa.\n\nA Chem está comemorando o seu aniversário de dezessete anos, e escolhemos algumas pessoas para participar dessa campanha exclusiva. O kit que você escolheu, cada item, cada produto, tudo o que você ganhou sairá de graça para você. Vamos te enviar kit completo, que somando tudo, dá valor de dois mil reais, e sairá de graça para você. A única coisa que a gente não consegue que seja grátis, é o envio, pois a Shen não tem sistema de logística própria, e precisamos terceirizar a entrega.\n\nEntão, o seu único custo para receber em casa dois mil reais em produtos exclusivos da Chen, será pequeno valor de frete, que garanto que não chega a cinquenta reais. Ou seja, você vai pagar o valor de uma pizza uma única vez, e vai receber em casa dois mil reais em produtos da Chen. Não deixe essa oportunidade passar."}],"hls_enabled":true,"embed_options":{"opaqueControls":null,"playerColor":"#000000","playerColorGradient":{"on":false,"colors":[["#ff5117",0],["#ffb77d",1]],"on":false,"colors":[["#ff5117",0],["#ffb77d",1]]},"plugin":{},"volumeControl":"false","fullscreenButton":"false","controlsVisibleOnLoad":"false","bpbTime"