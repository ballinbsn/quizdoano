/1\",\"bitRate\":\"3650243\",\"Codec ID\":\"avc1\",\"codec\":\"h264\",\"colorPrimaries\":\"bt709\",\"colorSpace\":\"bt709\",\"colorTransfer\":\"bt709\",\"duration\":87.033333,\"height\":1920,\"pixelFormat\":\"yuv420p\",\"rFrameRate\":\"30/1\",\"width\":1080}}","built_by":"render-pipeline","time_to_ready":23.425139472},"url":"https://embed-ssl.wistia.com/deliveries/f44c2a6ae674791247e50c40dc7d82f726c2d6e1.bin","created_at":1786341698,"segment_duration":3,"opt_vbitrate":5625},{"is_enhanced":false,"type":"still_image","slug":"still_image_1080x1920","display_name":"Thumbnail Image","details":{},"width":1080,"height":1920,"ext":"jpg","size":1093910,"bitrate":0,"public":true,"status":2,"progress":1.0,"metadata":{"time_to_ready":9.15311023},"url":"https://embed-ssl.wistia.com/deliveries/2d994fb4ddff08855cd312e972b9696d72bf5315.bin","created_at":1786341698},{"is_enhanced":false,"type":"storyboard","slug":"storyboard_3550x3600","display_name":"Storyboard","details":{},"width":3550,"height":3600,"ext":"jpg","size":1958198,"bitrate":0,"public":true,"status":2,"progress":1.0,"metadata":{"frame_count":174,"aspect_ratio":0.5625,"frame_height":200,"frame_width":355,"built_by":"render-pipeline","time_to_ready":8.11279699},"url":"https://embed-ssl.wistia.com/deliveries/d93a2bbbbddf19b160a4d127c4903b6007e5abed.bin","created_at":1786341698}],"branding":false,"createdAt":1786341697,"distilleryUrl":"https://distillery.wistia.com/x","duration":87.0516,"enableCustomerLogo":true,"firstEmbedForAccount":false,"firstShareForAccount":false,"availableTranscripts":[{"bcp47LanguageTag":"pt","familyName":"Portuguese","familyNativeName":"Português","hasCaptions":true,"hasVideoStream":false,"name":"Portuguese","nativeName":"Português","wistiaLanguageCode":"por","language":"por","ietf_language_tag":"por","alpha3_terminologic":"por","alpha3_bibliographic":"por","iso639_2_language_code":"pt","english_name":"Portuguese","native_name":"Português","right_to_left":false,"alpha3Bibliographic":"por","alpha3Terminologic":"por","ietfLanguageTag":"por","iso6392LanguageCode":"pt","genericName":"Portuguese","genericNativeName":"Português"}],"hashedId":"ugw7aeic2w","mediaId":151335323,"mediaKey":"wistia-production_151335323","mediaType":"Video","name":"Shein depoimentos novos","preloadPreference":null,"progress":1.0,"protected":false,"projectId":10872882,"seoDescription":"a Shein video","showAbout":true,"status":2,"type":"Video","playableWithoutInstantHls":true,"stats":{"loadCount":21968,"playCount":21812,"uniqueLoadCount":19244,"uniquePlayCount":20356,"averageEngagement":0.67508},"trackingTransmitInterval":20,"liveStreamEventDetails":null,"integrations":{},"tagManager":true,"captions":[{"language":"por","text":"Olha esse vestido que eu recebi da promoção de aniversário, eu só respondi umas perguntas no site oficial e a Chem me mandou esse kit completo, chegou muito rápido, eu estou apaixonada. Acabou de chegar aqui no meu portão, muita gente perguntando se funciona, olha aqui as provas. Fiz a pesquisa de aniversário da Chen, recebi tudo de graça. É super simples, qualquer pessoa consegue fazer.\n\nRoxa renovado e eu não gastei centavo. Participei da pesquisas oficial de aniversário da Chen, e ganhei esse kit maravilhoso. Foi super simples, só só responder as perguntas, chegou muito rápido. Gente, estou em choque, olha o tanto de coisa que eu recebi.\n\nEu participei da promoção de aniversário, respondi a pesquisa e chegou tudo isso aqui na minha porta. Eu jurava que era mentira, mas é real. Vocês não estão entendendo a minha alegria, eu vi o vídeo, respondi o questionário de aniversário da Shein, e olha o que acabou de chegar, é tudo meu, e foi super simples para ganhar, podem ir sem medo.\n\nEu confesso que não acreditava quando vi o vídeo, achei que não ia dar em nada, mas resolvi participar do questionário e olha, hoje o entregador chamou aqui e trouxe tudo isso.\n\nChegou certinho e sem pagar nada, gente. Olha, eu sou muito desconfiando dessas coisas de internet, mas meu netão me ajudou a responder a pesquisa de aniversário. E não é que chegou mesmo? Tudo embalarinho, roupas lindas.\n\nEstou muito feliz."}],"hls_enabled":true,"embed_options":{"opaqueControls":null,"playerColor":"#ff5117","playerColorGradient":{"on":false,"colors":[["#ff5117",0],["#ffb77d",1]],"on":false,"colors":[["#ff5117",0],["#ffb77d",1]]},"plugin":{},"volumeControl":"false","fullscreenButton":"false","controlsVisibleOnLoad":"false","bpbTime":"false","roundedPlayer":12,"vulcan":true,"autoPlay":"true","playButton":"false","smallPlayButton":"false","playbar":"false","settingsControl":"false","contrastIcons":null,"newRoundedIcons":true,"shouldShowCaptionsSettings":true},"embedOptions":{"opaqueControls":null,"playerColor":"#ff5117","playerColorGradient":{"on":false,"colors":[["#ff5117",0],["#ffb77d",1]],"on":false,"colors":[["#ff5117",0],["#ffb77d",1]]},"plugin":{},"volumeControl":"false","fullscreenButton":"false","controlsVisibleOnLoad":"false","bpbTime":"false","roundedPlayer":12,"vulcan":true,"autoPlay":"true","playButton":"false","smallPlayButton":"false","playbar":"false","settingsControl":"false","contrastIcons":null,"newRoundedIcons":true,"shouldShowCaptionsSettings":true}},"options":{}};
